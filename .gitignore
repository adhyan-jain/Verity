# ==========================================
# Verity - .gitignore
# ==========================================

# Raw Datasets & Data Files (Tracked for team access during sprint)
# Note: Re-enable exclusions when datasets are hosted externally


# Machine Learning Models & Checkpoints
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.bin

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Node / Frontend Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.log
