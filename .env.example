# Verity — environment configuration
# Copy to .env and fill in real values for local development:
#   cp .env.example .env
# All four backend services (agent :8000, fraud :8001, ledger :8002, typology
# :8003) and the dashboard dev server read from this single file when started
# via `scripts/dev_up.py` / `npm run dev` (see README.md "Run" section).

# ---------------------------------------------------------------------------
# Fraud engine (engines/fraud/api.py, port 8001)
# ---------------------------------------------------------------------------
# Shared secret the fraud engine requires on every protected route
# (X-API-Key header). The engine fails closed (503) if this is unset, and
# agent/tools.py forwards this same value on every live-mode call it makes
# into the fraud engine — keep both sides in sync.
FRAUD_API_KEY=dev-local-fraud-key
# Comma-separated browser origins allowed to call the fraud engine directly
# (only /health is called cross-origin by the dashboard; everything else goes
# through the agent). Empty = blocks every browser origin.
FRAUD_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Agent core (agent/api.py, port 8000) — consumed by agent/tools.py
# ---------------------------------------------------------------------------
# mock: agent tools read contracts/mock_data/ fixtures only, no HTTP calls.
# live: agent tools call the three engine APIs below, falling back to mock
#       fixtures on any timeout/connection error (never a hard failure).
VERITY_ENV=live
FRAUD_API_URL=http://localhost:8001/api/v1/fraud
LEDGER_API_URL=http://localhost:8002/api/v1/ledger
TYPOLOGY_API_URL=http://localhost:8003/api/v1/typology
AGENT_TOOL_TIMEOUT=2.0

# Optional external LLM for agent/llm.py's decide_next_step / chat. Unset =
# agent falls back to its deterministic built-in reasoning engine (still
# fully functional — this only swaps out the language model, not the tool
# loop or grounding filter).
VERITY_LLM_API_KEY=
VERITY_LLM_BASE_URL=https://api.openai.com/v1
VERITY_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Dashboard (dashboard/, Vite dev server on port 3000)
# ---------------------------------------------------------------------------
# Vite only exposes VITE_-prefixed vars to client code; these must be set at
# dev-server/build time, not just at Python process runtime.
VITE_AGENT_API_URL=http://localhost:8000
VITE_FRAUD_API_URL=http://localhost:8001/api/v1/fraud
VITE_LEDGER_API_URL=http://localhost:8002/api/v1/ledger
VITE_TYPOLOGY_API_URL=http://localhost:8003/api/v1/typology
# Must match FRAUD_API_KEY above. NOTE: this ships inside the client bundle —
# acceptable for this decision-support prototype behind an internal network,
# NOT for a public deployment. See ARCHITECTURE.md "Remaining gaps".
VITE_FRAUD_API_KEY=dev-local-fraud-key
