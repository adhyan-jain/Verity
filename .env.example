# Verity — environment configuration
# Copy to .env and fill in real values for local development:
#   cp .env.example .env
# All four backend services (agent :8000, fraud :8001, ledger :8002, typology
# :8003) and the dashboard dev server read from this single file when started
# via `scripts/dev_up.py` / `npm run dev` (see README.md "Run" section).

# ---------------------------------------------------------------------------
# Fraud engine (engines/fraud/api.py, port 8001)
# ---------------------------------------------------------------------------
# Shared secret the fraud engine requires on every protected route
# (X-API-Key header). The engine fails closed (503) if this is unset, and
# agent/tools.py forwards this same value on every live-mode call it makes
# into the fraud engine — keep both sides in sync.
FRAUD_API_KEY=dev-local-fraud-key
# Comma-separated browser origins allowed to call the fraud engine directly
# (only /health is called cross-origin by the dashboard; everything else goes
# through the agent). Empty = blocks every browser origin.
FRAUD_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Ledger engine (engines/ledger/api.py, port 8002)
# ---------------------------------------------------------------------------
# Same fail-closed X-API-Key pattern as the fraud engine. agent/tools.py
# forwards this on every live-mode call into the ledger engine.
LEDGER_API_KEY=dev-local-ledger-key
LEDGER_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Typology engine (engines/typology/api.py, port 8003)
# ---------------------------------------------------------------------------
TYPOLOGY_API_KEY=dev-local-typology-key
TYPOLOGY_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Agent core (agent/api.py, port 8000) — consumed by agent/tools.py
# ---------------------------------------------------------------------------
# Required by every /api/v1/agent/* route except /health.
AGENT_API_KEY=dev-local-agent-key
AGENT_CORS_ORIGINS=http://localhost:3000

# mock: agent tools read contracts/mock_data/ fixtures only, no HTTP calls.
# live: agent tools call the three engine APIs below, falling back to mock
#       fixtures on any timeout/connection error (never a hard failure).
VERITY_ENV=live
FRAUD_API_URL=http://localhost:8001/api/v1/fraud
LEDGER_API_URL=http://localhost:8002/api/v1/ledger
TYPOLOGY_API_URL=http://localhost:8003/api/v1/typology
AGENT_TOOL_TIMEOUT=2.0

# Optional external LLM for agent/llm.py's decide_next_step / chat. Unset =
# agent falls back to its deterministic built-in reasoning engine (still
# fully functional — this only swaps out the language model, not the tool
# loop or grounding filter).
#
# Active default: a local Ollama server running qwen3:8b
# (`ollama pull qwen3:8b`, then `ollama serve` if it isn't already running).
# VERITY_LLM_API_KEY only needs to be non-empty to enable the external-LLM
# path — Ollama's OpenAI-compatible endpoint doesn't check its value.
# agent/llm.py's resolve_llm_config() auto-detects "ollama" as the provider
# for any localhost/127.0.0.1 base_url and applies a longer default timeout
# (45s) since local generation is slower than a hosted API.
VERITY_LLM_PROVIDER=ollama
VERITY_LLM_API_KEY=ollama
VERITY_LLM_BASE_URL=http://localhost:11434/v1
VERITY_LLM_MODEL=qwen3:8b
#
# Alternative: free OpenRouter tier (no local model required)
# VERITY_LLM_PROVIDER=openrouter
# VERITY_LLM_API_KEY=sk-or-...
# VERITY_LLM_BASE_URL=https://openrouter.ai/api/v1
# VERITY_LLM_MODEL=openrouter/free
# VERITY_LLM_TIMEOUT=8.0
#
# Alternative: OpenAI
# VERITY_LLM_PROVIDER=openai
# VERITY_LLM_API_KEY=sk-...
# VERITY_LLM_BASE_URL=https://api.openai.com/v1
# VERITY_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Dashboard (dashboard/, Vite dev server on port 3000)
# ---------------------------------------------------------------------------
# Vite only exposes VITE_-prefixed vars to client code; these must be set at
# dev-server/build time, not just at Python process runtime.
VITE_AGENT_API_URL=http://localhost:8000
VITE_FRAUD_API_URL=http://localhost:8001/api/v1/fraud
VITE_LEDGER_API_URL=http://localhost:8002/api/v1/ledger
VITE_TYPOLOGY_API_URL=http://localhost:8003/api/v1/typology
# Must match FRAUD_API_KEY/LEDGER_API_KEY/TYPOLOGY_API_KEY/AGENT_API_KEY
# above. NOTE: these ship inside the client bundle — acceptable for this
# decision-support prototype behind an internal network, NOT for a public
# deployment. See ARCHITECTURE.md "Remaining gaps".
VITE_FRAUD_API_KEY=dev-local-fraud-key
VITE_LEDGER_API_KEY=dev-local-ledger-key
VITE_TYPOLOGY_API_KEY=dev-local-typology-key
VITE_AGENT_API_KEY=dev-local-agent-key
